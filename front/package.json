{
    "name": "kexamanager",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "generate:openapi": "npx --yes openapi-typescript https://garagehq.deuxfleurs.fr/api/garage-admin-v2.json -o src/types/openapi.ts && npx --yes prettier --write src/types/openapi.ts",
        "lint": "eslint .",
        "test": "bun test",
        "preview": "vite preview",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1132.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@monaco-editor/react": "^4.7.0",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "i18next": "^26.4.2",
        "lucide-react": "^1.46.0",
        "prettier": "^3.6.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-i18next": "^17.0.14",
        "react-router-dom": "^7.10.1",
        "recharts": "^3.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^10",
        "@types/bun": "^1.4.2",
        "@types/node": "^24",
        "@types/react": "^19.1.10",
        "@types/react-dom": "^19.1.7",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17",
        "openapi-typescript": "^7.13.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0"
    }
